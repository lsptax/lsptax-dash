# App runtime: "development" or "production". Production tightens CORS and DocuSign env checks.
NODE_ENV=development

# Browser origins allowed to call the API (comma-separated, no trailing slash). Needed for frontend in production; empty allows all when the list is empty (see index.js).
CORS_ORIGIN=

# Set to "true" to log every HTTP request. Off in production unless you set this.
LOG_REQUESTS=

# Controls whether multiple client contracts can be sent to the same client.
# Default behavior (unset/true): allow multiple sends.
# Set to "false" to enforce one active/sent-completed contract per client.
ALLOW_MULTIPLE_CLIENT_CONTRACT_SENDS=true

# Controls whether multiple AOA forms can be sent for the same property.
# Default behavior (unset/true): allow multiple sends.
# Set to "false" to enforce one active/sent-completed AOA per property.
ALLOW_MULTIPLE_AOA_SENDS=true

# PostgreSQL connection string for Prisma. Required for any DB access.
DATABASE_URL=

# Secret for signing JWT access tokens (login). Required for authenticated routes.
JWT_SECRET=

# Supabase project URL. Required for contract PDF storage and Supabase-backed features.
SUPABASE_URL=

# Supabase service role key (recommended for private buckets). Used by supabaseClient; preferred over SUPABASE_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase anon or fallback key. Used if service role is unset, and by createBackup for storage requests.
SUPABASE_KEY=

# DocuSign OAuth hostname for JWT (e.g. https://account-d.docusign.com dev, https://account.docusign.com prod). Required for DocuSign API calls.
DOCUSIGN_AUTH_SERVER=

# DocuSign integration key (client ID). Required for JWT and envelopes.
DOCUSIGN_CLIENT_ID=

# DocuSign user GUID to impersonate with JWT. Required for sending/checking envelopes.
DOCUSIGN_USER_ID=

# DocuSign account ID (API account ID). Required for envelope and document API paths.
DOCUSIGN_ACCOUNT_ID=

# DocuSign REST base URL. Dev: https://demo.docusign.net/restapi ; Production: https://www.docusign.net/restapi (or your account’s datacenter host).
DOCUSIGN_REST_BASE_URL=https://demo.docusign.net/restapi

# Connect webhook HMAC secret (from DocuSign Connect config). Required for /webhooks/docusign to accept callbacks; if unset, webhook returns 503.
DOCUSIGN_HMAC_SECRET=

# Path to RSA private key PEM for JWT. Optional; defaults to src/keys/private.key if unset.
# DOCUSIGN_PRIVATE_KEY_PATH=

# Public https API base (for DocuSign Go-Live validation warnings in production). Optional.
# DOCUSIGN_PUBLIC_APP_URL=

# Same as above; either can be set. Optional.
# PUBLIC_APP_URL=

# Set to 1 only if you intentionally run demo DocuSign endpoints with NODE_ENV=production. Optional escape hatch.
# DOCUSIGN_ALLOW_DEMO_IN_PRODUCTION=1

# Override max API calls per 30s burst (default 200 demo host, 500 prod). Optional.
# DOCUSIGN_BURST_LIMIT=

# Override max API calls per rolling hour (default 3000). Optional.
# DOCUSIGN_HOURLY_LIMIT=

# Brevo (Sendinblue) — transactional invoice email + SMS
BREVO_API_KEY=
# Invoice emails are sent from this address; replies go to the same inbox.
BREVO_INVOICE_SENDER_EMAIL=results@lsptax.com
BREVO_INVOICE_SENDER_NAME=LSPT Results
# Legacy fallback if BREVO_INVOICE_SENDER_EMAIL is unset
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Lone Star Property Tax
# SMS sender label (max 11 alphanumeric / 15 numeric chars in Brevo)
BREVO_SMS_SENDER=LSP Tax
# Secret token for /webhooks/brevo (append ?secret=<value> to the webhook URL in Brevo dashboard)
BREVO_WEBHOOK_SECRET=
# Public URL for Hussain signature logo in invoice emails (Supabase Storage)
INVOICE_EMAIL_LOGO_URL=
