                { "key": "offset", "value": "0", "description": "Records to skip (pagination)" },
                { "key": "search", "value": "", "description": "Filter by name, number, email, phone" },
                { "key": "accountType", "value": "", "description": "Optional filter. Allowed: real, bpp" }
